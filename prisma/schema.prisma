generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model user_information {
  Full_Name String @map("Full Name") @db.VarChar(255)
  Email     String @db.VarChar(255) @unique
  Password  String @db.VarChar(255)

  @@map("user information")
}
