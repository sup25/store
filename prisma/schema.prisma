generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int       @id @default(autoincrement())
  first_name     String    @db.VarChar(255)
  last_name      String    @db.VarChar(255)
  email          String    @unique @db.VarChar(255)
  password       String    @db.VarChar(255)
  addresses      Address[]
  phone          String?   @default("") @db.VarChar(255)
  role           String?   @default("user") @db.VarChar(255)
  personalize    Json?
  verified_phone Boolean?  @default(false)
  verified_email Boolean?  @default(false)
  created_at     DateTime  @default(now())
  tokens         Token[]
  Order          Order[]
  cart           Cart[]
  Review         Review[]
}

model Address {
  id      Int     @id @default(autoincrement())
  street  String  @db.VarChar(255)
  city    String  @db.VarChar(255)
  state   String  @db.VarChar(255)
  country String  @db.VarChar(255)
  zipcode String  @db.VarChar(255)
  apt     String? @db.VarChar(255)
  user    User    @relation(fields: [userId], references: [id])
  userId  Int
  orders  Order[] @relation("OrderToAddress")
}

model Token {
  id         Int      @id @default(autoincrement())
  token      String   @unique
  created_at DateTime @default(now())
  black_list Boolean  @default(false)
  expire     DateTime
  type       String
  user       User?    @relation(fields: [userId], references: [id])
  userId     Int?
  used       Boolean  @default(false)
  admin      Admin?   @relation(fields: [adminId], references: [id])
  adminId    Int?
}

model Admin {
  id         Int          @id @default(autoincrement())
  name       String       @db.VarChar(255)
  email      String       @unique @db.VarChar(255)
  password   String       @db.VarChar(255)
  role       String?      @default("admin") @db.VarChar(255)
  tokens     Token[]
  products   Product[]
  Status     Status[]
  OrderAdmin OrderAdmin[]
  createdAt  DateTime     @default(now())

  @@map("admin")
}

model Product {
  id           Int            @id @default(autoincrement())
  title        String         @db.VarChar(255)
  handle       String         @unique @db.VarChar(255)
  desc         String?
  short_desc   String?
  price        Int
  quantity     Int
  sku          String?        @db.VarChar(255)
  tags         String[]
  type         String
  images       ProductImage[]
  sales        Sale[]
  reviews      Review[]
  Admin        Admin?         @relation(fields: [adminId], references: [id])
  adminId      Int?
  OrderProduct OrderProduct[]
  cart         Cart[]
}

model ProductImage {
  id           Int     @id @default(autoincrement())
  original_url String  @db.VarChar(255)
  thumbnail    String  @db.VarChar(255)
  index        Int
  productId    Int
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Sale {
  id        Int       @id @default(autoincrement())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  products  Product[]
  orders    Order[]
}

model Order {
  id           Int            @id @default(autoincrement())
  address      Address        @relation(fields: [addressId], references: [id], name: "OrderToAddress")
  addressId    Int
  total_price  Int
  net_price    Int
  sale         Sale           @relation(fields: [saleId], references: [id])
  saleId       Int
  statuses     Status[]
  notes        String?
  OrderProduct OrderProduct[]
  user         User           @relation(fields: [userId], references: [id])
  userId       Int
  name         String
  admins       OrderAdmin[]
}

model OrderProduct {
  id        Int     @id @default(autoincrement())
  order     Order   @relation(fields: [orderId], references: [id])
  orderId   Int
  product   Product @relation(fields: [productId], references: [id])
  productId Int
  quantity  Int

  @@unique([orderId, productId])
}

model OrderAdmin {
  id       Int     @id @default(autoincrement())
  order    Order   @relation(fields: [orderId], references: [id])
  orderId  Int
  admin    Admin   @relation(fields: [adminId], references: [id])
  adminId  Int
  Status   Status? @relation(fields: [statusId], references: [id])
  statusId Int?

  @@unique([orderId, adminId])
}

model Status {
  id      Int          @id @default(autoincrement())
  type    String
  date    DateTime     @default(now())
  admins  OrderAdmin[]
  order   Order        @relation(fields: [orderId], references: [id])
  orderId Int
  Admin   Admin?       @relation(fields: [adminId], references: [id])
  adminId Int?
}

model Review {
  id        Int     @id @default(autoincrement())
  score     Float
  message   String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId Int
  user      User    @relation(fields: [userId], references: [id])
  userId    Int
}

model Cart {
  id        Int     @id @default(autoincrement())
  user      User    @relation(fields: [userId], references: [id])
  userId    Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId Int
  quantity  Int

  @@unique([userId, productId])
}
